{
  "projectId": "69b3f38b00343fcaac9e",
  "src": "main.py",
  "entrypoint": "main",
  "commands": {
    "start": "python3 -m uvicorn main:app --host 0.0.0.0 --port ${PORT:-8080}"
  },
  "runtime": "python",
  "timeout": 60,
  "execution": "trigger",
  "events": [
    {
      "type": "schedule",
      "cron": "0 2 * * *"
    }
  ],
  "environment": [
    {
      "key": "APPWRITE_DATABASE_ID",
      "value": "dz_guide_db"
    },
    {
      "key": "APPWRITE_ENDPOINT",
      "value": "https://fra.cloud.appwrite.io/v1"
    }
  ]
}